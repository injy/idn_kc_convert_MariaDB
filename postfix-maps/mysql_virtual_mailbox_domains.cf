# domain protocol  -> virtual_mailbox_domains
# Replaces: socketmap:unix:/run/postfix/php_mysql_maps.sock:domain
# Lookups are form-agnostic: kc_to_ascii() is applied to BOTH the stored
# column and the incoming key, so it works whether the row is stored as
# punycode/ACE or as native UTF-8.
user = mailserver
password = CHANGEME_DB_PASSWORD
hosts = 127.0.0.1
dbname = mailserver
query = SELECT COALESCE((SELECT domain FROM domain WHERE kc_to_ascii(domain) = kc_to_ascii('%s') LIMIT 1),(SELECT ad.target_domain FROM alias_domain ad WHERE kc_to_ascii(ad.alias_domain) = kc_to_ascii('%s') LIMIT 1))
