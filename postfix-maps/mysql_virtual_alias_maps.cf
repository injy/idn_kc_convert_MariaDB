# alias protocol -> virtual_alias_maps
# Replaces: socketmap:unix:/run/postfix/php_mysql_maps.sock:alias
#
# Precedence (as required):
#   1) specific alias        (address match)        -> goto
#   2) alias-domain rewrite  (local@target_domain)  -> rewritten address
#      *identity mappings excluded* -- see note below
#   3) local MAILBOX exists  -> '%s' (the address ITSELF, a no-op rewrite)
#      => the lookup SUCCEEDS, which stops Postfix's native '@domain'
#         catch-all fallback.  mail_addr_find() queries the full address
#         first and only re-queries the literal key '@domain' when the
#         full-address lookup returns NOTFOUND.  Returning NULL (old
#         behavior) let the catch-all hijack real mailboxes; returning
#         the address itself keeps them local.  Delivery then falls
#         through to virtual_mailbox_maps -> LMTP local delivery.
#   4) catch-all             (@domain)              -> goto
#      (also reachable natively: Postfix re-queries the key '@domain')
#
# IDENTITY EXCLUSION (critical):
#   alias_domain rows where kc_to_ascii(target_domain) = kc_to_ascii(alias_domain)
#   are NOT real alias domains -- they are just the UTF-8 spelling of a domain
#   that is already a mailbox domain (all 25 rows here are of this kind).
#   Rewriting "local@domain" to "local@domain" is a no-op that Postfix rejects
#   with "User unknown in virtual alias table", so step 2 must skip them.
#
# Lookups are form-agnostic: kc_to_ascii() is applied to BOTH the stored column
# and the incoming key, so a row stored as punycode/ACE or as native UTF-8 both
# match.  This requires kc_to_ascii() to PRESERVE a leading '@' (catch-all rows
# are stored as '@domain').
user = mailserver
password = CHANGEME_DB_PASSWORD
hosts = 127.0.0.1
dbname = mailserver
query = SELECT CASE WHEN (SELECT goto FROM alias WHERE kc_to_ascii(address)=kc_to_ascii('%s') AND active=1 LIMIT 1) IS NOT NULL THEN (SELECT goto FROM alias WHERE kc_to_ascii(address)=kc_to_ascii('%s') AND active=1 LIMIT 1) WHEN (SELECT target_domain FROM alias_domain WHERE kc_to_ascii(alias_domain)=kc_to_ascii(SUBSTRING_INDEX('%s','@',-1)) AND kc_to_ascii(target_domain) <> kc_to_ascii(alias_domain) LIMIT 1) IS NOT NULL THEN CONCAT(SUBSTRING_INDEX('%s','@',1),'@',(SELECT target_domain FROM alias_domain WHERE kc_to_ascii(alias_domain)=kc_to_ascii(SUBSTRING_INDEX('%s','@',-1)) AND kc_to_ascii(target_domain) <> kc_to_ascii(alias_domain) LIMIT 1)) WHEN EXISTS (SELECT 1 FROM mailbox WHERE kc_to_ascii(local_part)=kc_to_ascii(SUBSTRING_INDEX('%s','@',1)) AND kc_to_ascii(domain)=kc_to_ascii(SUBSTRING_INDEX('%s','@',-1)) AND active=1) THEN '%s' ELSE (SELECT goto FROM alias WHERE kc_to_ascii(address)=CONCAT('@',SUBSTRING_INDEX(kc_to_ascii('%s'),'@',-1)) AND active=1 LIMIT 1) END AS dest
