# idn protocol -> recipient_canonical_maps
# Replaces: socketmap:unix:/run/postfix/php_mysql_maps.sock:idn
# Normalises an incoming (UTF-8) recipient to its ACE/punycode form so the
# rest of the pipeline sees a consistent key. Sentinel outputs (empty input,
# >1 '@', >200 bytes) return NULL => NOTFOUND => no rewrite (mirrors the
# daemon's '' response for malformed input).
user = mailserver
password = CHANGEME_DB_PASSWORD
hosts = 127.0.0.1
dbname = mailserver
query = SELECT CASE WHEN kc_to_ascii('%s') IN ('no_input','too_many_at_2+','input_too_long') THEN NULL ELSE kc_to_ascii('%s') END
